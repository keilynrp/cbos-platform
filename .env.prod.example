# ═══════════════════════════════════════════════════════════
# CBOS Platform — Producción (.env.prod.example)
# Copia este archivo como .env.prod y rellena los valores.
# NUNCA subas .env.prod al repositorio.
# ═══════════════════════════════════════════════════════════

# ── Base de Datos ────────────────────────────────────────
POSTGRES_DB=cbos_prod
POSTGRES_USER=cbos
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── Backend ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_at_least_32_random_chars_here
ENVIRONMENT=production
DEBUG=false

# ── Dominio (sin https://) ───────────────────────────────
# Un solo dominio para frontend + API (nginx enruta por path)
DOMAIN=cbos.inbounduxd.com
# ALLOWED_ORIGINS se genera automáticamente desde DOMAIN en docker-compose.prod.yml:
# ALLOWED_ORIGINS: '["https://${DOMAIN}"]'
# No requiere configuración manual si DOMAIN está correcto.

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=true
FROM_EMAIL=no-reply@miempresa.com
FROM_NAME=CBOS Platform

# ── Portal (tokens de invitación) ────────────────────────
PORTAL_TOKEN_EXPIRE_HOURS=72

# ── Integraciones opcionales ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
