# ── App ───────────────────────────────────────────────────
APP_NAME="CBOS API"
ENVIRONMENT=development
DEBUG=false

# ── Database ──────────────────────────────────────────────
# Desarrollo nativo (scripts/dev-native.sh): puerto del mapeo en el host,
# definido por POSTGRES_PORT en el .env raíz (5433 por defecto).
DATABASE_URL=postgresql+asyncpg://cbos:cbos_dev_pass@localhost:5433/cbos_dev

# ── Redis ─────────────────────────────────────────────────
# Ídem — REDIS_PORT en el .env raíz (6380 por defecto).
REDIS_URL=redis://localhost:6380

# ── Auth JWT ──────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-256-bit-key

# ── CORS ──────────────────────────────────────────────────
# 8101 = Vite nativo (FRONTEND_PORT). 8080 = default de vite.config.ts.
ALLOWED_ORIGINS=["http://localhost:8101","http://localhost:8080"]

# ── AI (Fase 5) ───────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
