# ═══════════════════════════════════════════════════════════
# CBOS Platform — Variables de entorno
# Copiar a .env y ajustar valores
# ═══════════════════════════════════════════════════════════

# ── Puertos (rango CBOS: 8100-8199) ──────────────────────
# Convención de puertos por proyecto para evitar conflictos:
#   CBOS:           8100-8199
#   Otros proyectos: asignar rangos distintos (ej. 8200-8299)
BACKEND_PORT=8100
FRONTEND_PORT=8101
POSTGRES_PORT=5433
REDIS_PORT=6380

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=cbos_dev
POSTGRES_USER=cbos
POSTGRES_PASSWORD=cbos_dev_pass

# ── Auth ──────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ── Portal del cliente ────────────────────────────────────
PORTAL_BASE_URL=http://localhost:8101
PORTAL_TOKEN_EXPIRE_HOURS=72

# ── Email (SMTP) — dejar vacío en dev para modo log ───────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_USE_TLS=true
FROM_EMAIL=noreply@tudominio.com
FROM_NAME=CBOS Platform

# ── Dominios producción (Dokploy) ─────────────────────────
API_DOMAIN=api.tudominio.com
FRONTEND_DOMAIN=app.tudominio.com
